    const heart = heartShape();
    const colors = ["#FF69B4", "#FF1493"];
    const frame = () => {
      colors.forEach((color) => {
        window.confetti({
          particleCount: 2,
          angle: 60,
          spread: 55,
          shapes: [heart],
          origin: { x: domRec.left / window.innerWidth, y: yPosition },
          zIndex,
          colors: [color]
